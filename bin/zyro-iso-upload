#!/bin/bash

if [ $# -eq 0 ]; then
  echo "Usage: zyro-iso-upload [release/zyro.iso]"
  exit 1
fi

if [[ ! -f ~/.config/rclone/rclone.conf ]]; then
  echo "You must first configure rclone with the R2 credentials: zyro-iso-rclone-config"
  exit 1
fi

rclone copy $1 Zyro:zyro/ -P

if [[ -f $1.sig ]]; then
  rclone copy $1.sig Zyro:zyro/ -P
fi
